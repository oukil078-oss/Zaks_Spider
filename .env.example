# ==========================================
# ZAK'S SPIDER CONFIGURATION
# Note: Zaks_Spider runs 100% out of the box with zero env vars required!
# If Vercel KV or Postgres is configured, it will automatically use them.
# ==========================================

# AI Intelligence Engine (Optional - fallback to built-in cyber heuristics if empty)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Vercel KV Database (Optional - automatic out-of-the-box in-memory/client fallback)
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# Vercel Postgres Database (Optional)
POSTGRES_URL=""

# Vercel Access Token (For automated CLI deployments)
VERCEL_TOKEN=""
